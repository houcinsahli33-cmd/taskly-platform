# Port utilisé par le serveur
PORT=3000

# Adresse du serveur MySQL
DB_HOST=localhost

# Port MySQL
DB_PORT=3306

# Utilisateur MySQL
DB_USER=root

# Mot de passe MySQL local, vide avec XAMPP
DB_PASSWORD=

# Nom de la base de données du projet
DB_NAME=taskly_db

# Clé utilisée pour sécuriser les sessions de connexion
SESSION_SECRET=taskly_secret_key

# false en local, true sur Render avec TiDB Cloud
DB_SSL=false